NEXORA_WHATSAPP_NUMBER="0249736777"
NEXORA_CONTACT_EMAIL="alijohnkwameanonkati@gmail.com"
NEXORA_AGENCY_LOCATION="Accra · Remote Worldwide"

# OPTIONAL INQUIRY WEBHOOK (e.g., Slack, Discord, or CRM webhook URL)
INQUIRY_WEBHOOK_URL=""

